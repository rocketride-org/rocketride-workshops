# Normalise all text files to LF in the repo, regardless of the
# contributor's core.autocrlf setting, so notebooks diff cleanly.
* text=auto eol=lf

*.ipynb text eol=lf

# Binary assets — never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.whl binary
